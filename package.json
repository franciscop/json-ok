{
  "name": "json-ok",
  "version": "1.2.1",
  "description": "A quick way of validating json objects using json-schema",
  "repository": "github:franciscop/json-ok",
  "author": "Francisco Presencia <public@francisco.io> (https://francisco.io/)",
  "funding": "https://www.paypal.me/franciscopresencia/19",
  "license": "MIT",
  "keywords": [
    "json",
    "schema",
    "validation",
    "object",
    "structure"
  ],
  "scripts": {
    "build": "bun build index.js --outfile=index.min.js --minify --format=esm && npm run size && npm run build:prettier",
    "build:prettier": "prettier --write index.js *.json",
    "size": "echo $(gzip -c index.min.js | wc -c) bytes",
    "start": "bun test --watch",
    "test": "bun test --coverage",
    "lint": "oxlint index.js"
  },
  "main": "index.min.js",
  "type": "module",
  "files": [],
  "devDependencies": {
    "jsonschema": "^1.5.0",
    "oxlint": "^1.89.0",
    "prettier": "^3.9.10"
  }
}
